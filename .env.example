# Optional OpenAI fallback. It is disabled unless explicitly enabled in config.
OPENAI_API_KEY=

# Override the default config location when needed.
GRIDLOCK_CONFIG=config/gridlock.yaml
GRIDLOCK_RAW_DIR=data/raw

# API server overrides (defaults live in config/gridlock.yaml under api:).
GRIDLOCK_API_HOST=
GRIDLOCK_API_PORT=

# Frontend runtime settings.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=

