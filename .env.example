# Override the default config location when needed.
GRIDLOCK_CONFIG=config/gridlock.yaml
GRIDLOCK_RAW_DIR=data/raw

# API server overrides (defaults live in config/gridlock.yaml under api:).
GRIDLOCK_API_HOST=
GRIDLOCK_API_PORT=
# Comma-separated browser origins allowed to call the API (defaults to api.cors_origins).
GRIDLOCK_API_CORS_ORIGINS=

# Frontend runtime settings (read by frontend/next.config.ts from this repository root).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
# Must match api.service_name in config/gridlock.yaml; the UI refuses to use any other server.
NEXT_PUBLIC_API_SERVICE=gridlock
# Online basemap style (no key needed). Leave empty to always use the bundled state-boundary map.
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Online basemap for the light theme. Leave empty to use the bundled map (in light colors) in light theme.
NEXT_PUBLIC_MAP_STYLE_URL_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
# How long to wait for the online basemap before switching to the bundled one.
NEXT_PUBLIC_MAP_STYLE_TIMEOUT_MS=6000

