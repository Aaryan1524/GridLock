{
  "$defs": {
    "Bounds": {
      "properties": {
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        },
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        }
      },
      "required": [
        "west",
        "south",
        "east",
        "north"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "ConstructionWindow": {
      "properties": {
        "endDate": {
          "format": "date",
          "title": "Enddate",
          "type": "string"
        },
        "startDate": {
          "format": "date",
          "title": "Startdate",
          "type": "string"
        }
      },
      "required": [
        "startDate",
        "endDate"
      ],
      "title": "ConstructionWindow",
      "type": "object"
    },
    "DateRange": {
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "title": "DateRange",
      "type": "object"
    },
    "Endpoint": {
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/EndpointRole",
          "default": "unknown"
        }
      },
      "required": [
        "name"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "EndpointMatch": {
      "description": "How one named endpoint was (or was not) linked to public infrastructure.",
      "properties": {
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "featureId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Featureid"
        },
        "featureName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Featurename"
        },
        "nameScore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namescore"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "operator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "operatorRelation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operatorrelation"
        },
        "point": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "$ref": "#/$defs/EndpointRole"
        },
        "status": {
          "$ref": "#/$defs/EndpointMatchStatus"
        },
        "voltageKv": {
          "items": {
            "type": "number"
          },
          "title": "Voltagekv",
          "type": "array"
        }
      },
      "required": [
        "endpoint",
        "role",
        "status"
      ],
      "title": "EndpointMatch",
      "type": "object"
    },
    "EndpointMatchStatus": {
      "enum": [
        "matched",
        "override",
        "no_candidate",
        "ambiguous",
        "vetoed",
        "separation_rejected"
      ],
      "title": "EndpointMatchStatus",
      "type": "string"
    },
    "EndpointRole": {
      "enum": [
        "from",
        "to",
        "via",
        "single",
        "unknown"
      ],
      "title": "EndpointRole",
      "type": "string"
    },
    "EndpointStatus": {
      "description": "How endpoints were read from a project title; anything but a clean pair/site needs review.",
      "enum": [
        "explicit_pair",
        "chain",
        "single_site",
        "none"
      ],
      "title": "EndpointStatus",
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "breakdown": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Breakdown",
          "type": "object"
        },
        "level": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "level",
        "score"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNRESOLVED"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "GeometryMethod": {
      "enum": [
        "verified_full_line",
        "verified_endpoints_straight_line",
        "verified_endpoint_route",
        "verified_single_endpoint",
        "approximate_area_centroid",
        "human_verified_override",
        "unresolved"
      ],
      "title": "GeometryMethod",
      "type": "string"
    },
    "GeometryResolution": {
      "properties": {
        "featureIds": {
          "items": {
            "type": "string"
          },
          "title": "Featureids",
          "type": "array"
        },
        "isApproximation": {
          "title": "Isapproximation",
          "type": "boolean"
        },
        "matches": {
          "items": {
            "$ref": "#/$defs/EndpointMatch"
          },
          "title": "Matches",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/GeometryMethod"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "method",
        "isApproximation"
      ],
      "title": "GeometryResolution",
      "type": "object"
    },
    "Metadata": {
      "properties": {
        "distanceUnit": {
          "default": "km",
          "title": "Distanceunit",
          "type": "string"
        },
        "fixture": {
          "default": false,
          "title": "Fixture",
          "type": "boolean"
        },
        "labels": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Labels",
          "type": "object"
        },
        "schemaVersion": {
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceSnapshot"
          },
          "title": "Sources",
          "type": "array"
        },
        "thresholdsKm": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Thresholdskm",
          "type": "object"
        },
        "timelineGapDays": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Timelinegapdays",
          "type": "object"
        },
        "utilityColors": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Utilitycolors",
          "type": "object"
        },
        "utilityNames": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Utilitynames",
          "type": "object"
        },
        "zoneGuards": {
          "additionalProperties": true,
          "title": "Zoneguards",
          "type": "object"
        }
      },
      "required": [
        "thresholdsKm",
        "utilityColors"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Metrics": {
      "description": "Handoff section 28 metrics, computed from the real run; nothing here is estimated.",
      "properties": {
        "attentionCompressionRatio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attentioncompressionratio"
        },
        "automaticResolutionRate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Automaticresolutionrate",
          "type": "number"
        },
        "evidenceDistribution": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Evidencedistribution",
          "type": "object"
        },
        "geometryDistribution": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Geometrydistribution",
          "type": "object"
        },
        "humanVerifiedEndpoints": {
          "minimum": 0,
          "title": "Humanverifiedendpoints",
          "type": "integer"
        },
        "locatedProjects": {
          "minimum": 0,
          "title": "Locatedprojects",
          "type": "integer"
        },
        "notAssessedByUtility": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Notassessedbyutility",
          "type": "object"
        },
        "projects": {
          "minimum": 0,
          "title": "Projects",
          "type": "integer"
        },
        "projectsByUtility": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Projectsbyutility",
          "type": "object"
        },
        "projectsWithNamedEndpoints": {
          "minimum": 0,
          "title": "Projectswithnamedendpoints",
          "type": "integer"
        },
        "relationships": {
          "minimum": 0,
          "title": "Relationships",
          "type": "integer"
        },
        "relationshipsByTier": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Relationshipsbytier",
          "type": "object"
        },
        "zones": {
          "minimum": 0,
          "title": "Zones",
          "type": "integer"
        }
      },
      "required": [
        "projects",
        "projectsByUtility",
        "locatedProjects",
        "notAssessedByUtility",
        "projectsWithNamedEndpoints",
        "automaticResolutionRate",
        "humanVerifiedEndpoints",
        "relationships",
        "relationshipsByTier",
        "zones",
        "evidenceDistribution",
        "geometryDistribution"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "Point": {
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Point",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Project": {
      "properties": {
        "constructionWindow": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConstructionWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "endpointStatus": {
          "$ref": "#/$defs/EndpointStatus",
          "default": "none"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/Endpoint"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "estimatedCostUsd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedcostusd"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "filedStartDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filedstartdate"
        },
        "geometry": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry"
        },
        "geometryResolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeometryResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "plannedInServiceDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plannedinservicedate"
        },
        "projectName": {
          "minLength": 1,
          "title": "Projectname",
          "type": "string"
        },
        "projectType": {
          "$ref": "#/$defs/ProjectType"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "sponsor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sponsor"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "utility": {
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Utility",
          "type": "string"
        },
        "voltageKv": {
          "items": {
            "type": "number"
          },
          "title": "Voltagekv",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "utility",
        "projectName",
        "projectType",
        "source"
      ],
      "title": "Project",
      "type": "object"
    },
    "ProjectType": {
      "enum": [
        "transmission_line",
        "substation",
        "reactor",
        "other"
      ],
      "title": "ProjectType",
      "type": "string"
    },
    "Relationship": {
      "properties": {
        "approximate": {
          "title": "Approximate",
          "type": "boolean"
        },
        "closestPoints": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/Point"
            }
          ],
          "title": "Closestpoints",
          "type": "array"
        },
        "coordinationPlaybook": {
          "items": {
            "type": "string"
          },
          "title": "Coordinationplaybook",
          "type": "array"
        },
        "distanceKm": {
          "minimum": 0,
          "title": "Distancekm",
          "type": "number"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "geometryMethods": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GeometryMethod"
            },
            {
              "$ref": "#/$defs/GeometryMethod"
            }
          ],
          "title": "Geometrymethods",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "opportunityPriority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "projectA": {
          "minLength": 1,
          "title": "Projecta",
          "type": "string"
        },
        "projectB": {
          "minLength": 1,
          "title": "Projectb",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "spatialTier": {
          "$ref": "#/$defs/SpatialTier"
        },
        "timeline": {
          "$ref": "#/$defs/Timeline"
        }
      },
      "required": [
        "id",
        "projectA",
        "projectB",
        "distanceKm",
        "closestPoints",
        "spatialTier",
        "geometryMethods",
        "approximate",
        "timeline",
        "evidence"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "SourceRef": {
      "properties": {
        "document": {
          "minLength": 1,
          "title": "Document",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "projectIdRaw": {
          "minLength": 1,
          "title": "Projectidraw",
          "type": "string"
        },
        "rawFields": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rawfields",
          "type": "object"
        },
        "rawText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rawtext"
        }
      },
      "required": [
        "document",
        "projectIdRaw",
        "page"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceSnapshot": {
      "description": "A public input the payload was built from.",
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "retrievedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrievedat"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "SourceSnapshot",
      "type": "object"
    },
    "SpatialTier": {
      "enum": [
        "CROSSING",
        "SHARED_CORRIDOR",
        "SITE_LOGISTICS",
        "CREWS_EQUIPMENT"
      ],
      "title": "SpatialTier",
      "type": "string"
    },
    "Timeline": {
      "description": "How two projects relate in time; an in-service gap is never presented as a window overlap (I-6).",
      "properties": {
        "gapDays": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gapdays"
        },
        "isdWithinFiledSpan": {
          "default": false,
          "title": "Isdwithinfiledspan",
          "type": "boolean"
        },
        "overlapDays": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlapdays"
        },
        "relevance": {
          "$ref": "#/$defs/TimelineRelevance"
        },
        "type": {
          "$ref": "#/$defs/TimelineType"
        }
      },
      "required": [
        "type",
        "relevance"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "TimelineRelevance": {
      "description": "Window overlap, then one bucket per configured timeline_gap_days cutoff, then beyond them.",
      "enum": [
        "OVERLAPPING",
        "STRONG",
        "MEANINGFUL",
        "POSSIBLE",
        "WEAK",
        "UNKNOWN"
      ],
      "title": "TimelineRelevance",
      "type": "string"
    },
    "TimelineType": {
      "enum": [
        "IN_SERVICE_GAP",
        "WINDOW_OVERLAP",
        "WINDOW_GAP",
        "UNRESOLVED"
      ],
      "title": "TimelineType",
      "type": "string"
    },
    "Zone": {
      "description": "A regional coordination situation: a guarded group of related cross-utility relationships.",
      "properties": {
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "closestDistanceKm": {
          "minimum": 0,
          "title": "Closestdistancekm",
          "type": "number"
        },
        "coordinationThemes": {
          "items": {
            "type": "string"
          },
          "title": "Coordinationthemes",
          "type": "array"
        },
        "evidenceLevel": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "geographicSpanKm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geographicspankm"
        },
        "headline": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZoneHeadline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "inServiceRange": {
          "$ref": "#/$defs/DateRange"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "opportunityPriority": {
          "$ref": "#/$defs/Priority"
        },
        "projectIds": {
          "items": {
            "type": "string"
          },
          "title": "Projectids",
